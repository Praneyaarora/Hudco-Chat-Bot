# =============================================================================
# HUDCO Enterprise Conversational AI — Environment Configuration Template
# Copy this file to .env and configure your keys before running.
# Never commit your actual .env file or credentials to source control.
# =============================================================================

# Default Active LLM Provider: 'gemini' (default), 'local_qwen', 'claude', 'openai'
DEFAULT_LLM_PROVIDER=gemini

# Google Gemini API Key (Required for default cloud deployment)
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic Claude API Key (Optional)
ANTHROPIC_API_KEY=

# OpenAI API Key (Optional)
OPENAI_API_KEY=

# Tavily Search API Key for Live Web Retrieval Sub-Agent (Optional but recommended)
# Obtain from: https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# Web Search Configuration
ENABLE_WEB_SEARCH=true

# User Session Authentication & Security
# Generate a secure 32+ character secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace_with_a_secure_random_secret_min_32_chars

# Context & Conversation Storage Configuration
# For local offline development: Leave DATABASE_URL empty to use local context/ directory (zero external dependencies).
# For Render Free ($0/month) deployment: Provide your Neon Free PostgreSQL connection string.
# Create a free project at https://neon.tech (0.5 GB free storage, autosuspends when idle, $0 forever).
# Neon Connection String:
# DATABASE_URL=postgresql://user:password@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Local storage fallback directory (when DATABASE_URL is not set):
# For local development: ./context
# For Render deployment with persistent disk (if disk used): /var/data/context
CONTEXT_STORAGE_DIR=./context

# Server Network Configuration
# Render automatically injects PORT and sets RENDER=true
PORT=8501
USE_SECURE_COOKIES=false
# RENDER=true (Automatically set by Render environment)

# Optional Local LLM (Qwen GPU/CPU) Discovery Paths (Only for local deployment)
# DEFAULT_QWEN_MODEL_PATH=C:\path\to\qwen\weights
# DEFAULT_GPU_PYTHON_PATH=C:\path\to\cuda\venv\Scripts\python.exe

